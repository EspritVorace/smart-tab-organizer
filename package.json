{
  "name": "smart-tab-organizer",
  "version": "1.1.4",
  "packageManager": "pnpm@10.33.2",
  "type": "module",
  "scripts": {
    "test": "vitest run --config vitest.simple.config.ts",
    "test:watch": "vitest --watch --config vitest.simple.config.ts",
    "test:ui": "vitest --ui --config vitest.simple.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.simple.config.ts && node scripts/inject-coverage-into-ctrf.mjs",
    "test:e2e": "wxt build && xvfb-maybe playwright test",
    "test:e2e:ui": "wxt build && playwright test --ui",
    "test:e2e:headed": "wxt build && playwright test --headed",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:analyze": "wxt build --analyze",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "lint": "eslint src tests --max-warnings=0",
    "lint:fix": "eslint src tests --fix",
    "lint:ctrf": "eslint src tests --max-warnings=0 --format=./scripts/eslint-ctrf-formatter.cjs --output-file=ctrf/lint-ctrf-report.json",
    "postinstall": "wxt prepare",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "a11y:storybook:run": "storybook build -o storybook-static && concurrently -k -s first -n SB,TEST \"http-server storybook-static -p 6007 -s\" \"wait-on tcp:6007 && test-storybook --url http://127.0.0.1:6007\"",
    "a11y:storybook:consolidate": "node scripts/a11y-storybook-consolidate.mjs",
    "a11y:storybook": "pnpm a11y:storybook:run ; pnpm a11y:storybook:consolidate",
    "a11y:e2e": "A11Y_ENABLED=true wxt build && A11Y_ENABLED=true xvfb-maybe playwright test",
    "a11y:report": "node scripts/a11y-report.mjs",
    "a11y": "pnpm a11y:storybook && pnpm a11y:e2e && pnpm a11y:report",
    "screenshots": "pnpm build && xvfb-maybe playwright test --config=e2e-screenshots/playwright.screenshots.config.ts",
    "doc:scenarios": "pnpm build && xvfb-maybe playwright test --config=e2e-doc-scenarios/playwright.doc.config.ts",
    "doc:scenarios:audit": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/doc-scenarios-audit.mjs",
    "doc:scenarios:sync": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/doc-scenarios-sync.mjs",
    "shortcuts:doc": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/generate-shortcuts-doc.mjs",
    "docs:dev": "pnpm --dir docs dev",
    "docs:build": "pnpm --dir docs build",
    "docs:preview": "pnpm --dir docs preview",
    "design-system:bundle": "node scripts/build-design-system-bundle.mjs",
    "design-system:zip": "node scripts/build-design-system-bundle.mjs --zip"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "@playwright/test": "^1.59.1",
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/react": "^10.3.6",
    "@storybook/react-vite": "^10.3.6",
    "@storybook/test-runner": "^0.24.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "4.1.5",
    "@vitest/eslint-plugin": "^1.6.16",
    "axe-playwright": "2.2.2",
    "concurrently": "9.2.1",
    "esbuild-wasm": "^0.28.0",
    "eslint": "^10.3.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-playwright": "^2.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.0.3",
    "happy-dom": "^20.9.0",
    "http-server": "14.1.1",
    "playwright-ctrf-json-reporter": "^0.0.29",
    "postcss": "^8.5.14",
    "sharp": "^0.34.5",
    "storybook": "^10.3.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.5",
    "vitest-ctrf-json-reporter": "^0.0.3",
    "wait-on": "9.0.5",
    "wxt": "^0.20.25",
    "xvfb-maybe": "^0.2.1"
  },
  "dependencies": {
    "@dnd-kit/abstract": "^0.4.0",
    "@dnd-kit/helpers": "0.4.0",
    "@dnd-kit/react": "^0.4.0",
    "@hookform/resolvers": "^5.1.1",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-visually-hidden": "^1.2.4",
    "@radix-ui/themes": "^3.2.1",
    "@vitejs/plugin-react": "^6.0.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.14.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.5",
    "react-accessible-treeview": "^2.11.2",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.75.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@^4.0.0",
    "vite-node": "^6.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "spawn-sync",
      "sharp",
      "unrs-resolver"
    ],
    "patchedDependencies": {
      "vitest-ctrf-json-reporter@0.0.3": "patches/vitest-ctrf-json-reporter@0.0.3.patch"
    },
    "ignoredBuiltDependencies": [
      "@swc/core"
    ],
    "overrides": {
      "node-forge": "^1.4.0",
      "defu": "^6.1.5",
      "vite": "^8.0.10",
      "brace-expansion@1": "^1.1.13",
      "brace-expansion@2": "^2.0.3",
      "brace-expansion@5": "^5.0.5"
    }
  }
}
